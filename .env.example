AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Claude Code requires a Pro/Max subscription or Anthropic API billing:
# AI_PROVIDER=claude-code
# CLAUDE_MODEL=sonnet
# Optional full path if Claude Code is not on PATH:
# CLAUDE_CLI_PATH=C:\Users\you\.local\bin\claude.exe
# To use OpenAI instead, set AI_PROVIDER=openai and supply your server-side key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
